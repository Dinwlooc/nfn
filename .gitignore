# 点文件与点目录全忽略；白名单除外
.*
!/.gitignore
!/.gitattributes

# --- 恢复候选（Owner 2026-10-25：审查后可能恢复 .dsh 与 AGENTS.md 的仓库同步，届时取消下行注释） ---
# /.dsh/
# /AGENTS.md
AGENTS.md

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg
addons/
Unused/
*.translation

# Mono-specific ignores
data_*/

# --- .dsh 纳入版本控制（Owner 2026-10-27：点文件/点目录仍由首行 `.*` 忽略） ---
!/.dsh/
**/node_modules/
*.revlog.md

# --- 插件的 .dsh 兼容 junction（实体在 dsh-plugins/，junction 不重复入库） ---
/.dsh/godot-creator/
/.dsh/harness-skills/
dsh-plugins
# --- 实验档案：含会话 uuid 与本机绝对路径（如 C:/Users/70585），不进仓库 ---
/.dsh/experiments/
